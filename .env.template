# Copy to `.env.local` and fill in the values.

# Sender / recipient addresses for the contact form (src/config/transporter.ts)
FROM_EMAIL_USERNAME=
TO_EMAIL_USERNAME=

# Public site origin with protocol, e.g. https://blazzed.vercel.app
# Used for metadata/canonical URLs and the /api/* CORS allow-list
NEXT_PUBLIC_DOMAIN=

# SMTP transport (src/config/transporter.ts)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Yandex Metrika counter id, production only (src/widgets/Yandex/YandexMetrika.tsx)
NEXT_PUBLIC_YANDEX_METRIC_ID=

# Cloudflare Turnstile (src/app/api/mail/route.ts, src/widgets/MailForm/MailForm.tsx)
CLOUDFLARE_SECRET_KEY=
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=
